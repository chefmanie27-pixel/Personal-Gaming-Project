generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id                String                @id @default(cuid())
  email             String                @unique
  passwordHash      String
  role              UserRole              @default(USER)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  socialProfile     SocialProfile?
  followsOut        FollowEdge[]          @relation("follower")
  followsIn         FollowEdge[]          @relation("followed")
  blocksOut         BlockEdge[]           @relation("blocker")
  blocksIn          BlockEdge[]           @relation("blocked")
  socialReviews     CommunityReview[]
  reviewLikes       ReviewLike[]
  reviewReports     ReviewReport[]
  publications      PublishedCollection[]
  collectionFollows CollectionFollow[]
  activities        SocialActivity[]
  achievements      AchievementUnlock[]
  notifications     SocialNotification[]
  steamConnection   SteamConnection?
  journalRecords    JournalRecord[]
  workspace         UserWorkspace?
  library           LibraryEntry[]
  wishlist          WishlistItem[]
  alerts            PriceAlert[]
}

model Game {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String           @db.Text
  cover       String           @db.VarChar(1024)
  hero        String           @db.VarChar(1024)
  tagline     String
  releaseDate DateTime?
  developer   String
  publisher   String
  score       Decimal?         @db.Decimal(5, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  externalIds ExternalGameId[]
  reviews     Review[]
  listings    StoreListing[]
  wishlists   WishlistItem[]
}

model ExternalGameId {
  id         String @id @default(cuid())
  provider   String
  providerId String
  gameId     String
  game       Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model ReviewSource {
  id      String   @id @default(cuid())
  name    String   @unique
  website String
  reviews Review[]
}

model Review {
  id          String       @id @default(cuid())
  gameId      String
  sourceId    String
  original    Decimal?     @db.Decimal(6, 2)
  scale       Decimal?     @db.Decimal(6, 2)
  normalized  Decimal?     @db.Decimal(5, 2)
  url         String       @db.VarChar(512)
  publishedAt DateTime?
  attribution String?
  fetchedAt   DateTime     @default(now())
  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  source      ReviewSource @relation(fields: [sourceId], references: [id])

  @@unique([sourceId, url])
}

model Store {
  id       String         @id @default(cuid())
  name     String         @unique
  website  String
  listings StoreListing[]
}

model StoreListing {
  id          String          @id @default(cuid())
  gameId      String
  storeId     String
  externalId  String?
  platform    String?
  edition     String?
  purchaseUrl String          @db.VarChar(1024)
  game        Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  store       Store           @relation(fields: [storeId], references: [id])
  prices      RegionalPrice[]
  alerts      PriceAlert[]

  @@unique([storeId, externalId])
}

model RegionalPrice {
  id             String       @id @default(cuid())
  listingId      String
  region         String       @db.Char(2)
  currency       String       @db.Char(3)
  amount         Decimal      @db.Decimal(12, 2)
  originalAmount Decimal?     @db.Decimal(12, 2)
  discount       Decimal?     @db.Decimal(5, 2)
  sourceType     String
  observedAt     DateTime     @default(now())
  listing        StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, region, observedAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  target    Decimal? @db.Decimal(12, 2)
  currency  String   @default("ZAR") @db.Char(3)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model PriceAlert {
  id            String       @id @default(cuid())
  userId        String
  listingId     String
  target        Decimal      @db.Decimal(12, 2)
  currency      String       @default("ZAR") @db.Char(3)
  active        Boolean      @default(true)
  lastTriggered DateTime?
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing       StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model SyncLog {
  id         String     @id @default(cuid())
  provider   String
  job        String
  status     SyncStatus
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  processed  Int        @default(0)
  error      String?    @db.Text
}

model LibraryEntry {
  id        String   @id @default(cuid())
  userId    String
  slug      String   @db.VarChar(191)
  game      Json
  status    String   @default("Want to Play") @db.VarChar(32)
  favorite  Boolean  @default(false)
  rating    Float?
  hours     Float    @default(0)
  notes     String   @db.Text
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId, addedAt])
}

model UserWorkspace {
  journalMigrated Boolean  @default(false)
  id              String   @id @default(cuid())
  userId          String   @unique
  data            Json
  version         Int      @default(0)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalRecord {
  searchText String   @db.Text
  userId     String
  id         String   @db.Char(36)
  slug       String   @db.VarChar(191)
  title      String   @db.VarChar(500)
  game       Json
  entryDate  DateTime @db.Date
  kind       String   @db.VarChar(16)
  minutes    Int
  notes      String   @db.Text
  progress   String   @db.Text
  tags       Json
  spoiler    Boolean  @default(false)
  rating     Float?
  version    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, id])
  @@index([userId, entryDate, id])
  @@index([userId, kind, entryDate, id])
}

model SocialProfile {
  userId       String   @id
  username     String   @unique @db.VarChar(30)
  name         String   @db.VarChar(80)
  bio          String   @db.VarChar(1000)
  avatar       String   @db.VarChar(1024)
  banner       String   @db.VarChar(1024)
  visibility   String   @default("private") @db.VarChar(16)
  shareLibrary Boolean  @default(false)
  settings     Json
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visibility, username])
}

model FollowEdge {
  followerId String
  followedId String
  accepted   Boolean  @default(false)
  createdAt  DateTime @default(now())
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User     @relation("followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId, accepted, createdAt])
}

model BlockEdge {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model CommunityReview {
  id        String         @id @default(cuid())
  userId    String
  slug      String         @db.VarChar(191)
  game      Json
  title     String         @db.VarChar(120)
  body      String         @db.Text
  rating    Float
  spoiler   Boolean        @default(false)
  hidden    Boolean        @default(false)
  version   Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     ReviewLike[]
  reports   ReviewReport[]

  @@unique([userId, slug])
  @@index([slug, createdAt, id])
  @@index([userId, createdAt, id])
}

model ReviewLike {
  userId    String
  reviewId  String
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    CommunityReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@index([reviewId])
}

model ReviewReport {
  id        String          @id @default(cuid())
  userId    String
  reviewId  String
  reason    String          @db.VarChar(1000)
  status    String          @default("open") @db.VarChar(16)
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    CommunityReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([status, createdAt])
}

model PublishedCollection {
  id          String             @id @default(cuid())
  userId      String
  name        String             @db.VarChar(80)
  description String             @db.VarChar(2000)
  cover       String             @db.VarChar(1024)
  theme       String             @db.VarChar(80)
  visibility  String             @default("private") @db.VarChar(16)
  games       Json
  version     Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  followers   CollectionFollow[]

  @@index([visibility, createdAt, id])
  @@index([userId, createdAt, id])
}

model CollectionFollow {
  userId       String
  collectionId String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   PublishedCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([userId, collectionId])
  @@index([collectionId])
}

model SocialActivity {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @db.VarChar(32)
  entityId  String   @db.VarChar(191)
  title     String   @db.VarChar(500)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, entityId])
  @@index([createdAt, id])
  @@index([userId, createdAt, id])
}

model AchievementUnlock {
  userId     String
  key        String   @db.VarChar(40)
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

model SocialNotification {
  id        String    @id @default(cuid())
  userId    String
  dedupe    String    @db.VarChar(191)
  kind      String    @db.VarChar(32)
  actorId   String?
  entityId  String?   @db.VarChar(191)
  message   String    @db.VarChar(500)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupe])
  @@index([userId, createdAt, id])
  @@index([userId, readAt])
}

model SteamConnection {
  games        SteamGameSnapshot[]
  userId       String              @id
  steamId      String              @unique @db.VarChar(17)
  status       String              @default("idle") @db.VarChar(32)
  processed    Int                 @default(0)
  lastSyncedAt DateTime?
  leaseUntil   DateTime?
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SteamGameSnapshot {
  userId       String
  appId        Int
  minutes      Int
  achievements Json?
  fetchedAt    DateTime        @default(now())
  connection   SteamConnection @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, appId])
}
