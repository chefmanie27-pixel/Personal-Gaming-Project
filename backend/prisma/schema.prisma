generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  wishlist WishlistItem[]
  alerts PriceAlert[]
}

model Game {
  id String @id @default(cuid())
  slug String @unique
  title String
  description String @db.Text
  cover String @db.VarChar(1024)
  hero String @db.VarChar(1024)
  tagline String
  releaseDate DateTime?
  developer String
  publisher String
  score Decimal? @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  externalIds ExternalGameId[]
  reviews Review[]
  listings StoreListing[]
  wishlists WishlistItem[]
}

model ExternalGameId {
  id String @id @default(cuid())
  provider String
  providerId String
  gameId String
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  @@unique([provider, providerId])
}

model ReviewSource {
  id String @id @default(cuid())
  name String @unique
  website String
  reviews Review[]
}

model Review {
  id String @id @default(cuid())
  gameId String
  sourceId String
  original Decimal? @db.Decimal(6, 2)
  scale Decimal? @db.Decimal(6, 2)
  normalized Decimal? @db.Decimal(5, 2)
  url String @db.VarChar(512)
  publishedAt DateTime?
  attribution String?
  fetchedAt DateTime @default(now())
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  source ReviewSource @relation(fields: [sourceId], references: [id])
  @@unique([sourceId, url])
}

model Store {
  id String @id @default(cuid())
  name String @unique
  website String
  listings StoreListing[]
}

model StoreListing {
  id String @id @default(cuid())
  gameId String
  storeId String
  externalId String?
  platform String?
  edition String?
  purchaseUrl String @db.VarChar(1024)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id])
  prices RegionalPrice[]
  alerts PriceAlert[]
  @@unique([storeId, externalId])
}

model RegionalPrice {
  id String @id @default(cuid())
  listingId String
  region String @db.Char(2)
  currency String @db.Char(3)
  amount Decimal @db.Decimal(12, 2)
  originalAmount Decimal? @db.Decimal(12, 2)
  discount Decimal? @db.Decimal(5, 2)
  sourceType String
  observedAt DateTime @default(now())
  listing StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@index([listingId, region, observedAt])
}

model WishlistItem {
  id String @id @default(cuid())
  userId String
  gameId String
  target Decimal? @db.Decimal(12, 2)
  currency String @default("ZAR") @db.Char(3)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  @@unique([userId, gameId])
}

model PriceAlert {
  id String @id @default(cuid())
  userId String
  listingId String
  target Decimal @db.Decimal(12, 2)
  currency String @default("ZAR") @db.Char(3)
  active Boolean @default(true)
  lastTriggered DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing StoreListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@index([userId, active])
}

model SyncLog {
  id String @id @default(cuid())
  provider String
  job String
  status SyncStatus
  startedAt DateTime @default(now())
  finishedAt DateTime?
  processed Int @default(0)
  error String? @db.Text
}
